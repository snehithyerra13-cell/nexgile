# Nexgile-DecarbX Backend Environment Configuration
PROJECT_NAME="Nexgile-DecarbX Environmental Intelligence Platform"
ENVIRONMENT=development
PORT=8000
DEBUG=True

# Security & Authentication
SECRET_KEY=nexgile-decarbx-super-secure-production-jwt-secret-key-2025
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default: SQLite for local demo and zero-configuration setup
DATABASE_URL=sqlite:///./decarbx.db
# For PostgreSQL in production, switch to:
# DATABASE_URL=postgresql://user:password@localhost:5432/decarbx_db

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
